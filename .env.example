# --- Required in production -------------------------------------------------
# Long random string that signs login sessions (openssl rand -hex 32).
AUTH_SECRET=
# Your email. This account gets every Premium feature free and sees the Agents dashboard.
OWNER_EMAIL=

# --- Database (Supabase). Without these the site uses memory and forgets on restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (AI scripts and the agents)
ANTHROPIC_API_KEY=

# --- Payments (Stripe). Billing stays off until both are set.
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PREMIUM_PRICE_LABEL=$19/month

# --- Autonomous agents
# The scheduler calls /api/cycle with this secret. Agents only run on schedule when AGENTS_AUTORUN=on.
CRON_SECRET=
AGENTS_AUTORUN=off

# --- Optional
# PUBLIC_URL=https://your-domain.com
# EDITOR_FONT_FILE=/path/to/bold-font.ttf
